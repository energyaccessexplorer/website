<link href="{{> base}}/stylesheets/password-form.css" rel="stylesheet">

<link href="{{> base}}/stylesheets/status-p.css" rel="stylesheet">

<style>
  html {
    box-sizing: border-box;
  }

  *, *:before, *:after {
    box-sizing: inherit;
  }

  main {
    text-align: center;
  }

  p {
    margin: auto;
    padding: 4em;
    display: none;
  }

  #reset-password {
    display: none;
  }

  form {
    padding-top: 0;
  }
</style>

<p>Email confirmed. Lets set your password.</p>

{{> password-reset-reset-password}}

<script type="module">
  import { token, type, reset_password_form } from "{{> base}}/javascripts/password-form.js";

  const p = document.querySelector('main > p');

  // GoTrue's confirmation link redirects here with the new session in the
  // fragment, the same shape the recovery link uses.
  if (token && type === 'signup')
    reset_password_form();

  else
    p.innerText = "This confirmation link is no longer valid. Try logging in.";

  p.style.display = 'block';
</script>
