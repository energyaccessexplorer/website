<script>
  (function() {
    const hasLang = new URLSearchParams(location.search).has('lang');
    const isProtected = location.hostname.startsWith('protected.');
    if (!hasLang && !isProtected) return;

    window.liveSettings = {
      api_key: "e0fbb2a78c9b473f8c265e3bb1ca1a29",
      staging: !!location.hostname.match(/localhost/),
      picker: false,
    };

    const s = document.createElement('script');
    s.async = true;
    s.type = "text/javascript";
    s.src = "//cdn.transifex.com/live.js";

    document.head.append(s);
  })();
</script>
